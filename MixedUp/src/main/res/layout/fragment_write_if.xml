<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WriteIfFrag"
    android:background="@drawable/white_papers_tiled"
    android:id="@+id/layout">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/write_if_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.12" />

    <TextView

        android:id="@+id/textView13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Finish the prompt"
        android:textAppearance="@style/TextAppearance.WhatIf.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/write_if_title_top"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9" />

    <TextView
        android:id="@+id/whatIfPrefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What if"
        android:textColor="@color/black"
        android:textAppearance="@style/TextAppearance.WhatIf.Title"
        app:layout_constraintBaseline_toBaselineOf="@+id/ifQuestion"
        app:layout_constraintEnd_toStartOf="@+id/ifQuestion"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/ifQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:gravity="center"
        android:hint="your question"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:singleLine="true"

        android:textColorHint="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/writeIf_submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/whatIfPrefix"
        app:layout_constraintTop_toBottomOf="@+id/textView13"
        app:layout_constraintVertical_bias="0.4"
        app:layout_constraintWidth_max="380dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/writeIf_submit"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="115dp"
        android:layout_height="@dimen/button_height_hero"
        android:layout_marginBottom="@dimen/space_48"
        android:text="Submit"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/layout" />


</androidx.constraintlayout.widget.ConstraintLayout>
