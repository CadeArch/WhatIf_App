<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WriteIfFrag"
    android:background="@drawable/white_papers_tiled"
    android:id="@+id/layout">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/write_if_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14" />

    <TextView

        android:id="@+id/textView13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Finish the prompt"
        android:textAppearance="@style/TextAppearance.WhatIf.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/write_if_title_top"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9" />

    <LinearLayout
        android:id="@+id/question_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView13"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9">

        <TextView
            android:id="@+id/whatIfPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What if"
            android:textColor="@color/black"
            android:textAppearance="@style/TextAppearance.WhatIf.Title" />

        <EditText
            android:id="@+id/ifQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_16"
            android:gravity="center"
            android:hint="your question"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:singleLine="true"
            android:textColorHint="@color/black"
            android:textSize="20sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/writeIf_submit"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_hero"
        android:layout_marginTop="@dimen/space_32"
        android:text="Submit"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/question_row"
        app:layout_constraintStart_toStartOf="@+id/question_row"
        app:layout_constraintTop_toBottomOf="@+id/question_row"
        app:layout_constraintWidth_max="280dp"
        app:layout_constraintWidth_percent="0.5" />


</androidx.constraintlayout.widget.ConstraintLayout>
