<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WriteIfFrag"
    android:background="@drawable/white_papers_tiled"
    android:id="@+id/layout">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/write_then_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14" />

    <TextView
        android:id="@+id/instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Finish the response"
        android:textAppearance="@style/TextAppearance.WhatIf.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/write_then_title_top"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9" />

    <ScrollView
        android:id="@+id/scroller"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginTop="@dimen/space_32"
        android:background="@drawable/prompt_preview_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/instructions"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9">

        <TextView
            android:id="@+id/myIfQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="90dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text=""
            android:textColor="@color/black"
            android:textSize="24sp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/then_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroller"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.9">

        <TextView
            android:id="@+id/thenPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="then"
            android:textColor="@color/black"
            android:textAppearance="@style/TextAppearance.WhatIf.Title" />

        <EditText
            android:id="@+id/thenAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_16"
            android:gravity="center"
            android:hint="your response"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:singleLine="true"
            android:textColorHint="@color/black"
            android:textSize="20sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/writeThen_submit"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_hero"
        android:layout_marginTop="@dimen/space_32"
        android:text="Submit"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/then_row"
        app:layout_constraintStart_toStartOf="@+id/then_row"
        app:layout_constraintTop_toBottomOf="@+id/then_row"
        app:layout_constraintWidth_max="280dp"
        app:layout_constraintWidth_percent="0.5" />


</androidx.constraintlayout.widget.ConstraintLayout>
