<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".JoinGameFrag"
    android:background="@drawable/white_papers_tiled"
    android:id="@+id/layout">

    <include
        android:id="@+id/message_banner"
        layout="@layout/message_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/join_game_title_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.18" />

    <TextView
        android:id="@+id/join_game_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="Game Code"
        android:textAppearance="@style/TextAppearance.WhatIf.Headline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/join_game_title_top"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_percent="0.58" />

    <EditText
        android:id="@+id/enterGameCode"
        style="@style/RoomCodeText"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/space_32"
        android:gravity="center_horizontal"
        android:hint="Enter Join Code"
        android:imeOptions="actionDone"
        android:importantForAutofill="noExcludeDescendants"
        android:inputType="textNoSuggestions|text"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/join_game_title"
        app:layout_constraintWidth_max="360dp"
        app:layout_constraintWidth_percent="0.5" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/joinGame_back"
        style="@style/Widget.WhatIf.Button.Secondary"
        android:layout_width="140dp"
        android:layout_height="@dimen/button_height_hero"
        android:layout_marginTop="@dimen/space_48"
        android:text="back"
        app:layout_constraintEnd_toStartOf="@+id/joinGame_start"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enterGameCode" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/joinGame_start"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="140dp"
        android:layout_height="@dimen/button_height_hero"
        android:layout_marginStart="@dimen/space_24"
        android:text="join"
        app:layout_constraintBottom_toBottomOf="@+id/joinGame_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/joinGame_back"
        app:layout_constraintTop_toTopOf="@+id/joinGame_back" />

</androidx.constraintlayout.widget.ConstraintLayout>
