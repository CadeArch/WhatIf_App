<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WaitingForHostFrag"
    android:background="@drawable/white_papers_tiled"
    android:id="@+id/layout">

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_16"
            android:clipToPadding="false" />
    </FrameLayout>


    <!-- "start" is a host-only control kept in the top-right corner as its own fixed-size element,
         independent of the title's width, so it can never collide with or push off the title text
         regardless of how narrow the viewport is (it previously shared a horizontal chain with the
         title and the room code, which overflowed and overlapped on portrait-width screens). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/waitingForHost_start"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:text="start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView

        android:id="@+id/textView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        android:gravity="center_horizontal"
        android:text="Players Joining"
        android:textAppearance="@style/TextAppearance.WhatIf.Display"
        app:layout_constraintBottom_toTopOf="@+id/gameCode"
        app:layout_constraintEnd_toStartOf="@+id/waitingForHost_start"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout"
        app:layout_constraintWidth_max="420dp" />

    <TextView
        android:id="@+id/gameCode"
        style="@style/RoomCodeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text=""
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintWidth_percent="0.86" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_16"
        android:gravity="center_horizontal"
        android:text="Waiting For Host..."
        android:textAppearance="@style/TextAppearance.WhatIf.Title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gameCode"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintWidth_percent="0.86" />


</androidx.constraintlayout.widget.ConstraintLayout>
