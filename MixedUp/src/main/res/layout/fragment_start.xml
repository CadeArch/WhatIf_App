<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StartFragment"
    android:id="@+id/layout">

    <!-- TODO: Update blank fragment layout -->

    <EditText
        android:id="@+id/enterName"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:hint="enter your name..."
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout" />

    <TextView
        android:id="@+id/displayName"
        android:layout_width="250dp"
        android:layout_height="50dp"

        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:hint=""
        android:textSize="40sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/create_game"
        android:layout_width="350dp"
        android:layout_height="75dp"
        android:layout_marginTop="16dp"
        android:text="Create Game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="@+id/layout"
        app:layout_constraintTop_toBottomOf="@+id/displayName" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/joinGame"
        android:layout_width="350dp"
        android:layout_height="75dp"
        android:layout_marginTop="4dp"
        android:text="Join Game"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/create_game" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/signOut"
        android:layout_width="100dp"
        android:layout_height="75dp"
        android:text="Sign Out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.697"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/joinGame"
        app:layout_constraintVertical_bias="0.37" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back"
        android:layout_width="100dp"
        android:layout_height="75dp"
        android:text="back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.697"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/joinGame"
        app:layout_constraintVertical_bias="0.37" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/leaderboards_button"
        android:layout_width="100dp"
        android:layout_height="75dp"
        android:text="leader boards"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.301"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/joinGame"
        app:layout_constraintVertical_bias="0.37" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_button"
        android:layout_width="100dp"
        android:layout_height="75dp"
        android:text="profile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/joinGame"
        app:layout_constraintVertical_bias="0.37" />

</androidx.constraintlayout.widget.ConstraintLayout>