<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ReadSentenceFrag"
    android:id="@+id/layout">

    <!-- read_sentence_paper.xml stretched (gravity="fill") non-uniformly and looked distorted;
         paint the underlying bitmap directly with centerCrop instead. -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/lined_paper_read"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paper_text_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.13" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paper_text_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/read_if_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/read_if_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.42" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/read_then_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.64" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/read_controls_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.68" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/read_if_bottom"
        app:layout_constraintEnd_toStartOf="@id/paper_text_end"
        app:layout_constraintStart_toStartOf="@id/paper_text_start"
        app:layout_constraintTop_toTopOf="@id/read_if_top">

        <TextView
            android:id="@+id/myIfQuestion_ending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:minHeight="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="@color/black"
            android:textSize="30sp" />
    </ScrollView>

    <ScrollView
        android:id="@+id/scrollView3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/read_then_bottom"
        app:layout_constraintEnd_toStartOf="@id/paper_text_end"
        app:layout_constraintStart_toStartOf="@id/paper_text_start"
        app:layout_constraintTop_toBottomOf="@+id/scrollView2">

        <TextView
            android:id="@+id/myThenAnswer_ending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:layout_marginTop="0dp"
            android:minHeight="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="@color/black"
            android:textSize="28sp" />
    </ScrollView>

    <!-- 0dp-width + weight on the flexible controls (spinner/pass/next) so this row compresses to
         fit portrait's narrower width instead of overflowing four fixed dp widths; the FAB keeps
         its natural circular size. -->
    <Spinner
        android:id="@+id/spinnerObject"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/space_16"
        android:paddingStart="@dimen/space_16"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/readSentence"
        app:layout_constraintStart_toStartOf="@id/paper_text_start"
        app:layout_constraintTop_toBottomOf="@+id/read_controls_start"
        app:layout_constraintVertical_bias="0.45" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/readSentence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:contentDescription="@string/mic_content_description"
        app:fabCustomSize="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pass_reading_turn"
        app:layout_constraintStart_toEndOf="@+id/spinnerObject"
        app:layout_constraintTop_toBottomOf="@+id/read_controls_start"
        app:layout_constraintVertical_bias="0.45"
        app:srcCompat="@drawable/ic_baseline_mic_24" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pass_reading_turn"
        style="@style/Widget.WhatIf.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_standard"
        android:text="done"
        android:textSize="16sp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/next_frag"
        app:layout_constraintStart_toEndOf="@+id/readSentence"
        app:layout_constraintTop_toBottomOf="@+id/read_controls_start"
        app:layout_constraintVertical_bias="0.45" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/next_frag"
        style="@style/Widget.WhatIf.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_standard"
        android:layout_marginStart="@dimen/space_8"
        android:textSize="16sp"
        android:text="next"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/paper_text_end"
        app:layout_constraintStart_toEndOf="@+id/pass_reading_turn"
        app:layout_constraintTop_toBottomOf="@+id/read_controls_start"
        app:layout_constraintVertical_bias="0.45" />


</androidx.constraintlayout.widget.ConstraintLayout>
